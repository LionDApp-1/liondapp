{
  "name": "liondapp",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "api:typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "api:dev": "wrangler dev apps/api/src/index.ts",
    "api:deploy": "wrangler deploy apps/api/src/index.ts --config apps/api/wrangler.toml",
    "admin:dev": "wrangler pages dev . --cwd apps/admin",
    "admin:deploy": "wrangler pages deploy . --cwd apps/admin --project-name liondapp-admin --branch main",
    "site:dev": "wrangler pages dev apps/site",
    "site:deploy": "wrangler pages deploy apps/site --project-name liondapp-site --branch main"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.35.0"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@onsol/tldparser": "^0.6.7",
    "@scure/base": "^2.0.0",
    "@solana/web3.js": "^1.98.4",
    "jose": "^6.1.0",
    "buffer": "6.0.1"
  }
}
